{
 "list": {
  "id": "S5b",
  "objective": "Find enterprise-search, workplace-AI, and knowledge-management AI products that can also answer from the public web, and identify which web search provider powers that web answering.",
  "criteria": [
   {
    "name": "internal_data_product",
    "description": "The product searches or answers over an organization's internal data (documents, apps, wikis, tickets, or knowledge bases) for its employees. It is an enterprise-search, workplace-AI assistant, or knowledge-management AI product."
   },
   {
    "name": "public_web_answers",
    "description": "The product can also search the public web, or ground its answers in public web results, as a documented feature."
   }
  ],
  "fields": {
   "name": "Product name",
   "company": "Company that sells it",
   "url": "Official product or company URL",
   "web_search_provider": "The search engine or API that powers the web feature, or 'not disclosed'",
   "evidence_url": "URL documenting the web search feature",
   "provider_evidence_url": "URL that names the web search provider, or null if not disclosed"
  }
 },
