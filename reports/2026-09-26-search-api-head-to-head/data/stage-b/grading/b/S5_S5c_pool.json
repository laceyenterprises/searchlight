{
 "list": {
  "id": "S5c",
  "objective": "Find companies whose own public pages name Exa (Exa Labs, Exa AI, exa.ai) as a subprocessor or as the web search provider behind one of their product features.",
  "criteria": [
   {
    "name": "names_exa_on_own_domain",
    "description": "A page on the company's own domain (subprocessor list, trust center, docs, changelog, blog, or integration page) names Exa, Exa Labs, Exa AI, or exa.ai. The company is not Exa itself."
   },
   {
    "name": "exa_role",
    "description": "The page names Exa as a subprocessor, or as the web search or web data provider behind a feature of the company's own product. Exclude directories, marketplaces, and frameworks where Exa is only one optional integration that users configure with their own Exa API key."
   }
  ],
  "fields": {
   "name": "Company name",
   "url": "Official homepage URL",
   "exa_role": "How the page names Exa: 'subprocessor', or 'search provider for <feature>'",
   "evidence_url": "URL of the page on the company's own domain that names Exa",
   "page_date": "Date shown on that page (last updated or published), or null"
  }
 },
