{
 "set": "S5",
 "description": "Entity lists. Each list goes to Exa Agent (auto), Parallel FindAll (core), and Firecrawl /agent with the same objective, criteria, fields, item cap, and exclusion list (the entities the KB already knows). Exclusions are merged in from _S5_exclusions.json before the run.",
 "max_items": 20,
 "lists": [
  {
   "id": "S5a",
   "entity_type": "companies",
   "objective": "Find systems integrators, IT-services firms, and consultancies that have an agentic-AI practice and have published a web-search integration for AI agents.",
   "criteria": [
    {
     "name": "services_firm",
     "description": "The company is a systems integrator, IT-services firm, or consultancy that sells implementation or consulting services to enterprises. It is not a software product company."
    },
    {
     "name": "agentic_ai_practice",
     "description": "The company's own website describes a named practice, offering, platform, or accelerator for agentic AI or AI agents."
    },
    {
     "name": "published_web_search_integration",
     "description": "The company has published, on its own site, GitHub, blog, or a partner page, a solution, blueprint, reference architecture, open-source repository, or case study in which an AI agent calls a named web search API or tool (for example Exa, Tavily, Brave, Bing, Google, Perplexity, SerpApi, Parallel, or Firecrawl)."
    }
   ],
   "fields": {
    "name": "Company name",
    "url": "Official homepage URL",
    "practice": "Name of the agentic-AI practice, offering, or accelerator",
    "web_search_providers": "The web search API(s) or tool(s) named in the published integration",
    "evidence_url": "URL of the published integration"
   },
